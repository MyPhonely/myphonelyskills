{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Node strips types rather than compiling them, so the source must contain
    // no syntax that needs emitting: no enums, no namespaces, no parameter
    // properties. This flag makes the compiler enforce that.
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["*.ts", "lib/**/*.ts", "test/**/*.ts"]
}
